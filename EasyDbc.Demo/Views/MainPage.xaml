<Page
    x:Class="EasyDbc.Demo.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:EasyDbc.Models;assembly=EasyDbc"
    xmlns:properties="clr-namespace:EasyDbc.Demo.Properties"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:vm="clr-namespace:EasyDbc.Demo.ViewModels"
    d:DesignHeight="800"
    d:DesignWidth="1280"
    Style="{DynamicResource MahApps.Styles.Page}"
    mc:Ignorable="d">
    <Page.InputBindings>
        <KeyBinding
            Key="Z"
            Modifiers="Control"
            Command="{Binding UndoDeleteMessageCommand}" />
    </Page.InputBindings>
    <Page.Resources>
        <ObjectDataProvider
            x:Key="DbcValueTypeValues"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="model:DbcValueType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ContextMenu x:Key="MessageContextMenu">
            <MenuItem
                Header="Cut"
                Command="ApplicationCommands.Cut"
                CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem
                Header="Copy"
                Command="ApplicationCommands.Copy"
                CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem
                Header="Paste"
                Command="ApplicationCommands.Paste"
                CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem
                Header="Delete Message"
                Command="{Binding DataContext.DeleteMessageCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                CommandParameter="{Binding}" />
        </ContextMenu>
        <ContextMenu x:Key="SignalContextMenu">
            <MenuItem
                Header="Cut"
                Command="ApplicationCommands.Cut"
                CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem
                Header="Copy"
                Command="ApplicationCommands.Copy"
                CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem
                Header="Paste"
                Command="ApplicationCommands.Paste"
                CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem
                Header="Delete Signal"
                Command="{Binding DataContext.DeleteSignalCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                CommandParameter="{Binding}" />
        </ContextMenu>
        <HierarchicalDataTemplate
            DataType="{x:Type vm:MainViewModel+EditableMessageViewModel}"
            ItemsSource="{Binding Signals}">
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoSignals}" Value="True">
                                <Setter Property="Background" Value="#FFD0D0D0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasDuplicateName}" Value="True">
                                <Setter Property="Background" Value="#FFFFF59D" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasDuplicateId}" Value="True">
                                <Setter Property="Background" Value="{Binding DuplicateIdBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Viewbox
                    Grid.Column="0"
                    Width="12"
                    Height="12"
                    Margin="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ToolTip="{Binding SignalNameLengthTooltip}"
                    ToolTipService.InitialShowDelay="100">
                    <Viewbox.Style>
                        <Style TargetType="Viewbox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSignalNameTooLong}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Viewbox.Style>
                    <Path
                        Fill="#FFD32F2F"
                        Stroke="#FFD32F2F"
                        StrokeThickness="1"
                        Data="M12,2 L22,20 H2 Z M12,7 L12,13 M12,16 L12,18" />
                </Viewbox>
                <TextBox
                    Grid.Column="1"
                    Margin="2"
                    ContextMenu="{StaticResource MessageContextMenu}"
                    Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    Grid.Column="2"
                    Margin="2"
                    ContextMenu="{StaticResource MessageContextMenu}"
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="FontWeight" Value="Normal" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDuplicateName}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBox
                    Grid.Column="3"
                    Margin="2"
                    ContextMenu="{StaticResource MessageContextMenu}"
                    Text="{Binding CycleTime, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox
                    Grid.Column="4"
                    Margin="2"
                    ContextMenu="{StaticResource MessageContextMenu}"
                    SelectedValue="{Binding IsExtendedId}"
                    SelectedValuePath="Tag">
                    <ComboBoxItem Content="Standard">
                        <ComboBoxItem.Tag>
                            <sys:Boolean>False</sys:Boolean>
                        </ComboBoxItem.Tag>
                    </ComboBoxItem>
                    <ComboBoxItem Content="Extended">
                        <ComboBoxItem.Tag>
                            <sys:Boolean>True</sys:Boolean>
                        </ComboBoxItem.Tag>
                    </ComboBoxItem>
                </ComboBox>
                <TextBox
                    Grid.Column="5"
                    Margin="2"
                    ContextMenu="{StaticResource MessageContextMenu}"
                    Text="{Binding Dlc, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    Grid.Column="6"
                    Margin="2"
                    ContextMenu="{StaticResource MessageContextMenu}"
                    Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type vm:MainViewModel+EditableSignalViewModel}">
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNameTooLong}" Value="True">
                                <Setter Property="Background" Value="#FFFFE0E0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" SharedSizeGroup="SignalWarningColumn" />
                    <ColumnDefinition Width="160" SharedSizeGroup="SignalNameColumn" />
                    <ColumnDefinition Width="70" SharedSizeGroup="SignalStartBitColumn" />
                    <ColumnDefinition Width="70" SharedSizeGroup="SignalLengthColumn" />
                    <ColumnDefinition Width="110" SharedSizeGroup="SignalByteOrderColumn" />
                    <ColumnDefinition Width="120" SharedSizeGroup="SignalDataTypeColumn" />
                    <ColumnDefinition Width="70" SharedSizeGroup="SignalFactorColumn" />
                    <ColumnDefinition Width="70" SharedSizeGroup="SignalOffsetColumn" />
                    <ColumnDefinition Width="80" SharedSizeGroup="SignalMinimumColumn" />
                    <ColumnDefinition Width="80" SharedSizeGroup="SignalMaximumColumn" />
                    <ColumnDefinition Width="70" SharedSizeGroup="SignalUnitColumn" />
                    <ColumnDefinition Width="120" SharedSizeGroup="SignalValueTableColumn" />
                    <ColumnDefinition Width="90" SharedSizeGroup="SignalMuxColumn" />
                    <ColumnDefinition Width="160" SharedSizeGroup="SignalMuxRangesColumn" />
                    <ColumnDefinition Width="120" SharedSizeGroup="SignalGroupsColumn" />
                    <ColumnDefinition Width="*" SharedSizeGroup="SignalCommentColumn" />
                </Grid.ColumnDefinitions>
                <Viewbox
                    Grid.Column="0"
                    Width="12"
                    Height="12"
                    Margin="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ToolTip="{Binding NameLengthTooltip}"
                    ToolTipService.InitialShowDelay="100">
                    <Viewbox.Style>
                        <Style TargetType="Viewbox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNameTooLong}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Viewbox.Style>
                    <Path
                        Fill="#FFD32F2F"
                        Stroke="#FFD32F2F"
                        StrokeThickness="1"
                        Data="M12,2 L22,20 H2 Z M12,7 L12,13 M12,16 L12,18" />
                </Viewbox>
                <TextBox
                    Grid.Column="1"
                    Margin="2"
                    ContextMenu="{StaticResource SignalContextMenu}"
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    Grid.Column="2"
                    Margin="2"
                    ContextMenu="{StaticResource SignalContextMenu}"
                    Text="{Binding StartBit, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    Grid.Column="3"
                    Margin="2"
                    ContextMenu="{StaticResource SignalContextMenu}"
                    Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox
                    Grid.Column="4"
                    Margin="2"
                    ContextMenu="{StaticResource SignalContextMenu}"
                    SelectedItem="{Binding ByteOrder, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBox.ItemsSource>
                        <x:Array Type="{x:Type sys:String}">
                            <sys:String>Intel</sys:String>
                            <sys:String>Motorola</sys:String>
                        </x:Array>
                    </ComboBox.ItemsSource>
                </ComboBox>
                <ComboBox
                    Grid.Column="5"
                    Margin="2"
                    ContextMenu="{StaticResource SignalContextMenu}"
                    ItemsSource="{Binding Source={StaticResource DbcValueTypeValues}}"
                    SelectedItem="{Binding ValueType, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    Grid.Column="6"
                    Margin="2"
                    ContextMenu="{StaticResource SignalContextMenu}"
                    Text="{Binding Factor, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    Grid.Column="7"
                    Margin="2"
                    ContextMenu="{StaticResource SignalContextMenu}"
                    Text="{Binding Offset, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    Grid.Column="8"
                    Margin="2"
                    ContextMenu="{StaticResource SignalContextMenu}"
                    Text="{Binding Minimum, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    Grid.Column="9"
                    Margin="2"
                    ContextMenu="{StaticResource SignalContextMenu}"
                    Text="{Binding Maximum, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    Grid.Column="10"
                    Margin="2"
                    ContextMenu="{StaticResource SignalContextMenu}"
                    Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    Grid.Column="11"
                    Margin="2"
                    ContextMenu="{StaticResource SignalContextMenu}"
                    Text="{Binding ValueTable, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    Grid.Column="12"
                    Margin="2"
                    ContextMenu="{StaticResource SignalContextMenu}"
                    Text="{Binding Multiplexing, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    Grid.Column="13"
                    Margin="2"
                    ContextMenu="{StaticResource SignalContextMenu}"
                    Text="{Binding MultiplexRanges, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    Grid.Column="14"
                    Margin="2"
                    ContextMenu="{StaticResource SignalContextMenu}"
                    Text="{Binding SignalGroups, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    Grid.Column="15"
                    Margin="2"
                    ContextMenu="{StaticResource SignalContextMenu}"
                    Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            Margin="{StaticResource MediumLeftMargin}"
            Style="{StaticResource PageTitleStyle}"
            Text="{x:Static properties:Resources.MainPageTitle}" />

        <Grid
            Grid.Row="1"
            Margin="{StaticResource MediumLeftRightMargin}"
            Background="{DynamicResource MahApps.Brushes.Gray10}">
            <!--
            The Mahapps Gray10 color represents where you should place your content.
            Place your content here.
            -->
            <!--  Content  -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  File Path  -->
                <GroupBox
                    Grid.Row="0"
                    Margin="{StaticResource SmallLeftRightMargin}"
                    Header="Orginal File Path"
                    Style="{StaticResource MahApps.Styles.GroupBox}">
                    <!--  Main Content of Group box  -->
                    <StackPanel Orientation="Vertical">
                        <!--  First Line Content  -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Width="150"
                                VerticalAlignment="Center"
                                Text="File Path 1:" />
                            <ComboBox
                                Width="300"
                                Margin="{StaticResource SmallLeftMargin}"
                                VerticalAlignment="Center"
                                IsEditable="True"
                                ItemsSource="{Binding RecentInputFiles}"
                                Text="{Binding FilePath1, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Width="80"
                                Margin="{StaticResource SmallLeftMargin}"
                                Command="{Binding OpenFileCommand}"
                                CommandParameter="FilePath1"
                                Content="Open" />
                            <Button
                                Width="80"
                                Margin="{StaticResource SmallLeftMargin}"
                                Command="{Binding ClearFileCommand}"
                                CommandParameter="FilePath1"
                                Content="Clear" />
                        </StackPanel>
                        <!--  Second Line Content  -->
                        <StackPanel Margin="{StaticResource SmallTopMargin}" Orientation="Horizontal">
                            <TextBlock
                                Width="150"
                                VerticalAlignment="Center"
                                Text="File Path 2:" />
                            <ComboBox
                                Width="300"
                                Margin="{StaticResource SmallLeftMargin}"
                                VerticalAlignment="Center"
                                IsEditable="True"
                                ItemsSource="{Binding RecentInputFiles}"
                                Text="{Binding FilePath2, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Width="80"
                                Margin="{StaticResource SmallLeftMargin}"
                                Command="{Binding OpenFileCommand}"
                                CommandParameter="FilePath2"
                                Content="Open" />
                            <Button
                                Width="80"
                                Margin="{StaticResource SmallLeftMargin}"
                                Command="{Binding ClearFileCommand}"
                                CommandParameter="FilePath2"
                                Content="Clear" />
                        </StackPanel>
                        <!--  Third Line Content  -->
                        <StackPanel Margin="{StaticResource SmallTopMargin}" Orientation="Horizontal">
                            <TextBlock
                                Width="150"
                                VerticalAlignment="Center"
                                Text="File Path 3:" />
                            <ComboBox
                                Width="300"
                                Margin="{StaticResource SmallLeftMargin}"
                                VerticalAlignment="Center"
                                IsEditable="True"
                                ItemsSource="{Binding RecentInputFiles}"
                                Text="{Binding FilePath3, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Width="80"
                                Margin="{StaticResource SmallLeftMargin}"
                                Command="{Binding OpenFileCommand}"
                                CommandParameter="FilePath3"
                                Content="Open" />
                            <Button
                                Width="80"
                                Margin="{StaticResource SmallLeftMargin}"
                                Command="{Binding ClearFileCommand}"
                                CommandParameter="FilePath3"
                                Content="Clear" />
                        </StackPanel>
                    </StackPanel>

                </GroupBox>
                <!--  File Generation  -->
                <GroupBox
                    Grid.Row="1"
                    Margin="{StaticResource SmallLeftRightMargin}"
                    Header="File Generation">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Width="150"
                                VerticalAlignment="Center"
                                Text="Output Dbc File Path :" />
                            <ComboBox
                                Width="300"
                                Margin="{StaticResource SmallLeftMargin}"
                                VerticalAlignment="Center"
                                IsEditable="True"
                                ItemsSource="{Binding RecentDbcOutputFiles}"
                                Text="{Binding OutputDbcFilePath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Width="80"
                                Margin="{StaticResource SmallLeftMargin}"
                                Command="{Binding SaveFileCommand}"
                                CommandParameter="OutputDbcFilePath"
                                Content="Open" />
                            <Button
                                Width="80"
                                Margin="{StaticResource SmallLeftMargin}"
                                Command="{Binding GenerateFileCommand}"
                                CommandParameter="dbc"
                                Content="Gen DBC" />
                        </StackPanel>
                        <StackPanel Margin="{StaticResource SmallTopMargin}" Orientation="Horizontal">
                            <TextBlock
                                Width="150"
                                VerticalAlignment="Center"
                                Text="Output Excel File Path :" />
                            <ComboBox
                                Width="300"
                                Margin="{StaticResource SmallLeftMargin}"
                                VerticalAlignment="Center"
                                IsEditable="True"
                                ItemsSource="{Binding RecentExcelOutputFiles}"
                                Text="{Binding OutputExcelFilePath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Width="80"
                                Margin="{StaticResource SmallLeftMargin}"
                                Command="{Binding SaveFileCommand}"
                                CommandParameter="OutputExcelFilePath"
                                Content="Open" />
                            <Button
                                Width="80"
                                Margin="{StaticResource SmallLeftMargin}"
                                Command="{Binding GenerateFileCommand}"
                                CommandParameter="excel"
                                Content="Gen Excel" />
                        </StackPanel>
                        <CheckBox
                            Margin="{StaticResource SmallTopMargin}"
                            VerticalAlignment="Center"
                            Content="Enable SignalGroup / multiplex Excel columns"
                            IsChecked="{Binding IncludeSignalGroupExcelColumns, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </GroupBox>
                <!--  DBC Content  -->
                <GroupBox
                    Grid.Row="2"
                    Margin="{StaticResource SmallLeftRightMargin}"
                    Header="File Content">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel
                            Grid.Row="0"
                            Margin="{StaticResource SmallTopMargin}"
                            Orientation="Horizontal">
                            <Button Command="{Binding ParsingMessageCommand}" Content="Refresh" />
                            <TextBlock
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Text="Processing...">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Expander
                            Grid.Row="1"
                            Margin="{StaticResource SmallTopMargin}"
                            Header="Nodes"
                            IsExpanded="True">
                            <ScrollViewer>
                                <TextBlock
                                    Margin="{StaticResource SmallLeftTopRightBottomMargin}"
                                    HorizontalAlignment="Stretch"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Text="{Binding Nodes}" />
                            </ScrollViewer>
                        </Expander>
                        <Expander
                            Grid.Row="2"
                            Header="Messages"
                            IsExpanded="True">
                            <Grid Grid.IsSharedSizeScope="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel
                                    Grid.Row="0"
                                    Margin="0,0,0,8"
                                    Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Text="Sort By:" />
                                    <ComboBox
                                        Width="120"
                                        Margin="8,0,0,0"
                                        ItemsSource="{Binding MessageSortFields}"
                                        SelectedItem="{Binding SelectedMessageSortField, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding ToggleMessageSortDirectionCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,4,0" Text="{Binding SortDirectionIcon}" />
                                            <TextBlock Text="{Binding SortDirectionText}" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding ToggleExpandAllMessagesCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,4,0" Text="{Binding ToggleExpandIcon}" />
                                            <TextBlock Text="{Binding ToggleExpandText}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <Grid Grid.Row="1" Margin="38,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" SharedSizeGroup="SignalWarningColumn" />
                                        <ColumnDefinition Width="160" SharedSizeGroup="SignalNameColumn" />
                                        <ColumnDefinition Width="70" SharedSizeGroup="SignalStartBitColumn" />
                                        <ColumnDefinition Width="70" SharedSizeGroup="SignalLengthColumn" />
                                        <ColumnDefinition Width="110" SharedSizeGroup="SignalByteOrderColumn" />
                                        <ColumnDefinition Width="120" SharedSizeGroup="SignalDataTypeColumn" />
                                        <ColumnDefinition Width="70" SharedSizeGroup="SignalFactorColumn" />
                                        <ColumnDefinition Width="70" SharedSizeGroup="SignalOffsetColumn" />
                                        <ColumnDefinition Width="80" SharedSizeGroup="SignalMinimumColumn" />
                                        <ColumnDefinition Width="80" SharedSizeGroup="SignalMaximumColumn" />
                                        <ColumnDefinition Width="70" SharedSizeGroup="SignalUnitColumn" />
                                        <ColumnDefinition Width="120" SharedSizeGroup="SignalValueTableColumn" />
                                        <ColumnDefinition Width="90" SharedSizeGroup="SignalMuxColumn" />
                                        <ColumnDefinition Width="160" SharedSizeGroup="SignalMuxRangesColumn" />
                                        <ColumnDefinition Width="120" SharedSizeGroup="SignalGroupsColumn" />
                                        <ColumnDefinition Width="*" SharedSizeGroup="SignalCommentColumn" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontWeight="Bold" Text="!" />
                                    <TextBlock Grid.Column="1" FontWeight="Bold" Text="Signal Name" />
                                    <TextBlock Grid.Column="2" FontWeight="Bold" Text="Start Bit" />
                                    <TextBlock Grid.Column="3" FontWeight="Bold" Text="Length" />
                                    <TextBlock Grid.Column="4" FontWeight="Bold" Text="Byte Order" />
                                    <TextBlock Grid.Column="5" FontWeight="Bold" Text="Data Type" />
                                    <TextBlock Grid.Column="6" FontWeight="Bold" Text="Factor" />
                                    <TextBlock Grid.Column="7" FontWeight="Bold" Text="Offset" />
                                    <TextBlock Grid.Column="8" FontWeight="Bold" Text="Minimum" />
                                    <TextBlock Grid.Column="9" FontWeight="Bold" Text="Maximum" />
                                    <TextBlock Grid.Column="10" FontWeight="Bold" Text="Unit" />
                                    <TextBlock Grid.Column="11" FontWeight="Bold" Text="ValueTable" />
                                    <TextBlock Grid.Column="12" FontWeight="Bold" Text="Mux" />
                                    <TextBlock Grid.Column="13" FontWeight="Bold" Text="Mux Ranges" />
                                    <TextBlock Grid.Column="14" FontWeight="Bold" Text="Groups" />
                                    <TextBlock Grid.Column="15" FontWeight="Bold" Text="Comment" />
                                </Grid>
                                <TreeView
                                    x:Name="MessageTreeView"
                                    Grid.Row="2"
                                    BorderThickness="0"
                                    ItemsSource="{Binding MessageItemsView}"
                                    ScrollViewer.CanContentScroll="True"
                                    VirtualizingStackPanel.IsVirtualizing="True"
                                    VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
                                            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMessageItem}" Value="True">
                                                    <Setter Property="ContextMenu" Value="{StaticResource MessageContextMenu}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                </TreeView>
                            </Grid>
                        </Expander>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</Page>
