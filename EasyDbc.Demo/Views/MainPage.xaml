<Page
    x:Class="EasyDbc.Demo.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:EasyDbc.Models;assembly=EasyDbc"
    xmlns:properties="clr-namespace:EasyDbc.Demo.Properties"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    d:DesignHeight="800"
    d:DesignWidth="1280"
    Style="{DynamicResource MahApps.Styles.Page}"
    mc:Ignorable="d">
    <Page.InputBindings>
        <KeyBinding
            Key="Z"
            Modifiers="Control"
            Command="{Binding UndoDeleteMessageCommand}" />
    </Page.InputBindings>
    <Page.Resources>
        <ObjectDataProvider
            x:Key="DbcValueTypeValues"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="model:DbcValueType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            Margin="{StaticResource MediumLeftMargin}"
            Style="{StaticResource PageTitleStyle}"
            Text="{x:Static properties:Resources.MainPageTitle}" />

        <Grid
            Grid.Row="1"
            Margin="{StaticResource MediumLeftRightMargin}"
            Background="{DynamicResource MahApps.Brushes.Gray10}">
            <!--
            The Mahapps Gray10 color represents where you should place your content.
            Place your content here.
            -->
            <!--  Content  -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  File Path  -->
                <GroupBox
                    Grid.Row="0"
                    Margin="{StaticResource SmallLeftRightMargin}"
                    Header="Orginal File Path"
                    Style="{StaticResource MahApps.Styles.GroupBox}">
                    <!--  Main Content of Group box  -->
                    <StackPanel Orientation="Vertical">
                        <!--  First Line Content  -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Width="150"
                                VerticalAlignment="Center"
                                Text="File Path 1:" />
                            <TextBox
                                Width="300"
                                Margin="{StaticResource SmallLeftMargin}"
                                VerticalAlignment="Center"
                                Text="{Binding FilePath1}" />
                            <Button
                                Width="80"
                                Margin="{StaticResource SmallLeftMargin}"
                                Command="{Binding OpenFileCommand}"
                                CommandParameter="FilePath1"
                                Content="Open" />
                            <Button
                                Width="80"
                                Margin="{StaticResource SmallLeftMargin}"
                                Command="{Binding ClearFileCommand}"
                                CommandParameter="FilePath1"
                                Content="Clear" />
                        </StackPanel>
                        <!--  Second Line Content  -->
                        <StackPanel Margin="{StaticResource SmallTopMargin}" Orientation="Horizontal">
                            <TextBlock
                                Width="150"
                                VerticalAlignment="Center"
                                Text="File Path 2:" />
                            <TextBox
                                Width="300"
                                Margin="{StaticResource SmallLeftMargin}"
                                VerticalAlignment="Center"
                                Text="{Binding FilePath2}" />
                            <Button
                                Width="80"
                                Margin="{StaticResource SmallLeftMargin}"
                                Command="{Binding OpenFileCommand}"
                                CommandParameter="FilePath2"
                                Content="Open" />
                            <Button
                                Width="80"
                                Margin="{StaticResource SmallLeftMargin}"
                                Command="{Binding ClearFileCommand}"
                                CommandParameter="FilePath2"
                                Content="Clear" />
                        </StackPanel>
                        <!--  Third Line Content  -->
                        <StackPanel Margin="{StaticResource SmallTopMargin}" Orientation="Horizontal">
                            <TextBlock
                                Width="150"
                                VerticalAlignment="Center"
                                Text="File Path 3:" />
                            <TextBox
                                Width="300"
                                Margin="{StaticResource SmallLeftMargin}"
                                VerticalAlignment="Center"
                                Text="{Binding FilePath3}" />
                            <Button
                                Width="80"
                                Margin="{StaticResource SmallLeftMargin}"
                                Command="{Binding OpenFileCommand}"
                                CommandParameter="FilePath3"
                                Content="Open" />
                            <Button
                                Width="80"
                                Margin="{StaticResource SmallLeftMargin}"
                                Command="{Binding ClearFileCommand}"
                                CommandParameter="FilePath3"
                                Content="Clear" />
                        </StackPanel>
                    </StackPanel>

                </GroupBox>
                <!--  File Generation  -->
                <GroupBox
                    Grid.Row="1"
                    Margin="{StaticResource SmallLeftRightMargin}"
                    Header="File Generation">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Width="150"
                                VerticalAlignment="Center"
                                Text="Output Dbc File Path :" />
                            <TextBox
                                Width="300"
                                Margin="{StaticResource SmallLeftMargin}"
                                VerticalAlignment="Center"
                                Text="{Binding OutputDbcFilePath}" />
                            <Button
                                Width="80"
                                Margin="{StaticResource SmallLeftMargin}"
                                Command="{Binding SaveFileCommand}"
                                CommandParameter="OutputDbcFilePath"
                                Content="Open" />
                            <Button
                                Width="80"
                                Margin="{StaticResource SmallLeftMargin}"
                                Command="{Binding GenerateFileCommand}"
                                CommandParameter="dbc"
                                Content="Gen DBC" />
                        </StackPanel>
                        <StackPanel Margin="{StaticResource SmallTopMargin}" Orientation="Horizontal">
                            <TextBlock
                                Width="150"
                                VerticalAlignment="Center"
                                Text="Output Excel File Path :" />
                            <TextBox
                                Width="300"
                                Margin="{StaticResource SmallLeftMargin}"
                                VerticalAlignment="Center"
                                Text="{Binding OutputExcelFilePath}" />
                            <Button
                                Width="80"
                                Margin="{StaticResource SmallLeftMargin}"
                                Command="{Binding SaveFileCommand}"
                                CommandParameter="OutputExcelFilePath"
                                Content="Open" />
                            <Button
                                Width="80"
                                Margin="{StaticResource SmallLeftMargin}"
                                Command="{Binding GenerateFileCommand}"
                                CommandParameter="excel"
                                Content="Gen Excel" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <!--  DBC Content  -->
                <GroupBox
                    Grid.Row="2"
                    Margin="{StaticResource SmallLeftRightMargin}"
                    Header="File Content">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel
                            Grid.Row="0"
                            Margin="{StaticResource SmallTopMargin}"
                            Orientation="Horizontal">
                            <Button Command="{Binding ParsingMessageCommand}" Content="Refresh" />
                        </StackPanel>
                        <Expander
                            Grid.Row="1"
                            Margin="{StaticResource SmallTopMargin}"
                            Header="Nodes"
                            IsExpanded="True">
                            <ScrollViewer>
                                <TextBlock
                                    Margin="{StaticResource SmallLeftTopRightBottomMargin}"
                                    HorizontalAlignment="Stretch"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Text="{Binding Nodes}" />
                            </ScrollViewer>
                        </Expander>
                        <Expander
                            Grid.Row="2"
                            Header="Messages"
                            IsExpanded="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel
                                    Grid.Row="0"
                                    Margin="0,0,0,8"
                                    Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Text="Sort By:" />
                                    <ComboBox
                                        Width="120"
                                        Margin="8,0,0,0"
                                        ItemsSource="{Binding MessageSortFields}"
                                        SelectedItem="{Binding SelectedMessageSortField, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding ToggleMessageSortDirectionCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,4,0" Text="{Binding SortDirectionIcon}" />
                                            <TextBlock Text="{Binding SortDirectionText}" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding ToggleExpandAllMessagesCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,4,0" Text="{Binding ToggleExpandIcon}" />
                                            <TextBlock Text="{Binding ToggleExpandText}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding MessageItemsView}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Expander Margin="0,0,0,6" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                                    <Expander.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem
                                                                Header="Delete Message"
                                                                Command="{Binding DataContext.DeleteMessageCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                CommandParameter="{Binding}" />
                                                        </ContextMenu>
                                                    </Expander.ContextMenu>
                                                    <Expander.Header>
                                                        <Grid>
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasNoSignals}" Value="True">
                                                                            <Setter Property="Background" Value="#FFD0D0D0" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasDuplicateName}" Value="True">
                                                                            <Setter Property="Background" Value="#FFFFF59D" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasDuplicateId}" Value="True">
                                                                            <Setter Property="Background" Value="{Binding DuplicateIdBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="130" />
                                                                <ColumnDefinition Width="170" />
                                                                <ColumnDefinition Width="80" />
                                                                <ColumnDefinition Width="100" />
                                                                <ColumnDefinition Width="80" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox
                                                                Grid.Column="0"
                                                                Margin="2"
                                                                Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBox
                                                                Grid.Column="1"
                                                                Margin="2"
                                                                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}">
                                                                <TextBox.Style>
                                                                    <Style TargetType="TextBox">
                                                                        <Setter Property="FontWeight" Value="Normal" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasDuplicateName}" Value="True">
                                                                                <Setter Property="FontWeight" Value="Bold" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>
                                                            <TextBox
                                                                Grid.Column="2"
                                                                Margin="2"
                                                                Text="{Binding CycleTime, UpdateSourceTrigger=PropertyChanged}" />
                                                            <ComboBox
                                                                Grid.Column="3"
                                                                Margin="2"
                                                                SelectedValue="{Binding IsExtendedId}"
                                                                SelectedValuePath="Tag">
                                                                <ComboBoxItem Content="Standard">
                                                                    <ComboBoxItem.Tag>
                                                                        <sys:Boolean>False</sys:Boolean>
                                                                    </ComboBoxItem.Tag>
                                                                </ComboBoxItem>
                                                                <ComboBoxItem Content="Extended">
                                                                    <ComboBoxItem.Tag>
                                                                        <sys:Boolean>True</sys:Boolean>
                                                                    </ComboBoxItem.Tag>
                                                                </ComboBoxItem>
                                                            </ComboBox>
                                                            <TextBox
                                                                Grid.Column="4"
                                                                Margin="2"
                                                                Text="{Binding Dlc, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBox
                                                                Grid.Column="5"
                                                                Margin="2"
                                                                Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                                                        </Grid>
                                                    </Expander.Header>

                                                    <DataGrid
                                                        Margin="0,6,0,0"
                                                        AutoGenerateColumns="False"
                                                        CanUserAddRows="False"
                                                        CanUserDeleteRows="False"
                                                        ItemsSource="{Binding Signals}">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Header="Signal Name" />
                                                            <DataGridTextColumn Binding="{Binding StartBit, UpdateSourceTrigger=PropertyChanged}" Header="Start Bit" />
                                                            <DataGridTextColumn Binding="{Binding Length, UpdateSourceTrigger=PropertyChanged}" Header="Length" />
                                                            <DataGridComboBoxColumn Header="Byte Order" SelectedItemBinding="{Binding ByteOrder, UpdateSourceTrigger=PropertyChanged}">
                                                                <DataGridComboBoxColumn.ItemsSource>
                                                                    <x:Array Type="{x:Type sys:String}">
                                                                        <sys:String>Intel</sys:String>
                                                                        <sys:String>Motorola</sys:String>
                                                                    </x:Array>
                                                                </DataGridComboBoxColumn.ItemsSource>
                                                            </DataGridComboBoxColumn>
                                                            <DataGridComboBoxColumn
                                                                Header="Data Type"
                                                                ItemsSource="{Binding Source={StaticResource DbcValueTypeValues}}"
                                                                SelectedItemBinding="{Binding ValueType, UpdateSourceTrigger=PropertyChanged}" />
                                                            <DataGridTextColumn Binding="{Binding Factor, UpdateSourceTrigger=PropertyChanged}" Header="Factor" />
                                                            <DataGridTextColumn Binding="{Binding Offset, UpdateSourceTrigger=PropertyChanged}" Header="Offset" />
                                                            <DataGridTextColumn Binding="{Binding Minimum, UpdateSourceTrigger=PropertyChanged}" Header="Minimum" />
                                                            <DataGridTextColumn Binding="{Binding Maximum, UpdateSourceTrigger=PropertyChanged}" Header="Maximum" />
                                                            <DataGridTextColumn Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Header="Unit" />
                                                            <DataGridTextColumn Binding="{Binding ValueTable, UpdateSourceTrigger=PropertyChanged}" Header="ValueTable" />
                                                            <DataGridTextColumn Binding="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Header="Comment" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Expander>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</Page>
